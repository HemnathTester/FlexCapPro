# Tests run against UAT only
TARGET_ENV=UAT
# Supplier/Buyer portal and Backoffice portal URLs
BASE_URL=
BACKOFFICE_URL=

# Test accounts (yopmail inboxes: https://yopmail.com)
BUYER_EMAIL=buyer1000@yopmail.com
BUYER_PASSWORD=
BUYER_MOBILE=
SUPPLIER_EMAIL=supplier1000@yopmail.com
SUPPLIER_PASSWORD=
SUPPLIER_MOBILE=

YOPMAIL_URL=https://yopmail.com/en/wm
DEFAULT_PASSWORD=

# Dev team fixed the UAT login/Forgot-Password OTP to this static test value (project-wide, every module).
# The suite never reads yopmail or asks for an OTP any more: it types this value directly. "Verify Your Email"
# is unaffected and still goes through the real emailed link.
STATIC_OTP=000000
